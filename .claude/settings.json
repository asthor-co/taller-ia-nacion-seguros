{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(py *)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(.venv/Scripts/python *)",
      "Bash(pip install *)",
      "Bash(pip list *)",
      "Bash(pip show *)",
      "Bash(pytest *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/Scripts/pytest.exe *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git check-ignore *)",
      "Bash(git --version)",
      "PowerShell(python *)",
      "PowerShell(py *)",
      "PowerShell(.venv\\Scripts\\python.exe *)",
      "PowerShell(.venv/Scripts/python.exe *)",
      "PowerShell(pip install *)",
      "PowerShell(pytest *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git check-ignore *)",
      "PowerShell(git --version)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)"
    ]
  }
}
